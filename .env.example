# Supabase project credentials — copy to .env.local for local dev,
# and configure these as Environment Variables in Vercel for production.

# Server-only (used by serverless functions in /api). Never expose to client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Client-readable (CRA prefix). Used only as a fallback if the API is down;
# the serverless layer is the canonical access path.
REACT_APP_API_BASE=/api

# ─────────────────────────────────────────────────────────────────────────
# AI BRD generator (free-tier providers — at least one required for /ai/*)
# ─────────────────────────────────────────────────────────────────────────
#
# Primary: Groq free tier. Sign up at https://console.groq.com (no credit card),
# generate an API key, paste here. Free quota covers ~hundreds of BRDs/month.
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile

# Fallback: Google Gemini free tier. Generate a key at https://aistudio.google.com.
# NOTE: Gemini's free tier uses prompts for product improvement; this provider
# is invoked ONLY when Groq is rate-limited or unreachable.
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.0-flash

# Per-provider timeout (ms). 8s leaves room for sequential fallback within
# Vercel Pro's 60s budget. On Hobby (10s), single call still succeeds.
AI_PROVIDER_TIMEOUT_MS=8000

# ─────────────────────────────────────────────────────────────────────────
# Cron (nightly AI insights refresh)
# ─────────────────────────────────────────────────────────────────────────
# Set any long random string. Vercel attaches it as a Bearer header when
# invoking /api/cron/insights nightly, and the function rejects anyone
# else. Generate one via e.g.
#   openssl rand -hex 32
CRON_SECRET=
