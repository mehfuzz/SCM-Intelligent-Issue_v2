# Oracle Autonomous Database credentials
# Copy to .env.local for local dev; set as Environment Variables in Vercel for production.

# Oracle ADB — Always Free tier on Oracle Cloud (cloud.oracle.com)
ORACLE_USER=ADMIN
ORACLE_PASSWORD=your-adb-admin-password
ORACLE_CONNECT_STRING=(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.YOUR_REGION.oraclecloud.com))(connect_data=(service_name=YOUR_DB_service_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# mTLS wallet — required when mTLS cannot be disabled on ADB (Always Free).
# 1. ADB console → Database Connection → Download wallet → set a password → download zip
# 2. Run: unzip Wallet_*.zip ewallet.pem && base64 -w 0 ewallet.pem
# 3. Paste the base64 output as ORACLE_WALLET_PEM below.
ORACLE_WALLET_PEM=
ORACLE_WALLET_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# AI BRD generator (free-tier providers — at least one required for /ai/*)
# ─────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.0-flash

AI_PROVIDER_TIMEOUT_MS=8000

# ─────────────────────────────────────────────────────────────────────────
# Cron (nightly AI insights refresh)
# ─────────────────────────────────────────────────────────────────────────
# openssl rand -hex 32
CRON_SECRET=

# React app — leave as-is for Vercel
REACT_APP_API_BASE=/api
