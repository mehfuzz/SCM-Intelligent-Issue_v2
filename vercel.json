{
  "buildCommand": "npm install && cd frontend && npm install --legacy-peer-deps && DISABLE_ESLINT_PLUGIN=true CI=false GENERATE_SOURCEMAP=false npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    { "source": "/api/auth/login",        "destination": "/api/users" },
    { "source": "/api/insights/feedback", "destination": "/api/insights" },
    { "source": "/api/cron/insights",     "destination": "/api/insights?cron=1" },
    { "source": "/api/chat-sessions",     "destination": "/api/ai/leadership-chat" },
    { "source": "/((?!api/).*)",          "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/insights?cron=1", "schedule": "0 2 * * *" }
  ]
}
